# CardioTrack CT-200 Document Tree Environment Configuration

# SQLite Database URL
DATABASE_URL=sqlite:///./doc_tree.db

# MongoDB Configuration (optional, falls back to local JSON file if unreachable)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=doc_tree_qa

# LLM Provider Configuration (Groq or OpenAI compatible)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative: OPENAI_API_KEY=sk-...
